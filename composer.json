{
    "name": "seb-jean/zodiac-sign-bundle",
    "description": "This bundle allows you to resolve the zodiac sign from various data types.",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SebJean\\ZodiacSignBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SebJean\\ZodiacSignBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "seb-jean",
            "email": "sebastien.jean76@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/translation": "^7.3",
        "symfony/clock": "^7.3",
        "symfony/dependency-injection": "^7.3",
        "symfony/http-kernel": "^7.3",
        "twig/twig": "^3.22"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^7.3",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    }
}
